# Narrare — Environment Configuration
# Copy to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# E2E test mode: set to "1" to use TestModel for all LLM providers
# (no real API calls — prevents 401 errors from missing credentials)
NARRARE_E2E_TEST=
LOG_LEVEL=DEBUG
# Log file for development (set to enable dual-handler: INFO+ to terminal, DEBUG+ to file)
LOG_FILE=
SECRET_KEY=change-me-run-just-generate-secret

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://narrare:narrare@localhost:5432/narrare_dev
TEST_DATABASE_URL=postgresql+asyncpg://narrare:narrare@localhost:5433/narrare_test

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# AI Providers — add at least one
# ---------------------------------------------------------------------------

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google
GOOGLE_API_KEY=

# Groq
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Z.AI
ZAI_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# API Key Encryption (required for AI provider features)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If this key is lost, all user API keys are unrecoverable.
# ---------------------------------------------------------------------------
NARRARE_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Default models (override per-project in .narrare/config.yaml)
# ---------------------------------------------------------------------------
DEFAULT_WRITING_MODEL=claude-sonnet-4-5-20251020
DEFAULT_ANALYSIS_MODEL=claude-haiku-3-5-20241022
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Memory (mem0)
# ---------------------------------------------------------------------------
MEMORY_LLM_MODEL=gpt-4o-mini
MEMORY_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Email (optional — for auth flows)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@narrare.local

# ---------------------------------------------------------------------------
# Dev overrides
# ---------------------------------------------------------------------------
# Pre-seeded dev account (created by scripts/seed_dev_user.py)
DEV_USER_EMAIL=dev@narrare.dev
DEV_USER_PASSWORD=narrare-dev
