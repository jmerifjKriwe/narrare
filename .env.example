# Narrare — environment configuration.
# Copy to .env; `just dev-setup` and the devcontainer do that for you.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The integration suites share narrare_v2_test and the E2E suites create their
# own databases, so they set this variable themselves before importing the app.
NARRE_DATABASE_URL=postgresql+asyncpg://narrare:narrare@localhost:5432/narrare_v2_dev

# ---------------------------------------------------------------------------
# Migration backups — the copy taken before an upgrade applies revisions
# ---------------------------------------------------------------------------
# Before an upgrade that would apply pending revisions, the database is
# dumped here (pg_dump custom format, restorable with pg_restore, last 3
# kept). An upgrade with nothing pending invokes no dump tool at all.
NARRE_BACKUP_DIR=./backups
# Set to skip to upgrade without a dump — only after taking your own copy;
# a failed upgrade then has nothing to restore from.
# NARRE_MIGRATION_BACKUP=pg_dump    # pg_dump (default) | skip
# The dump command as a template with {url} and {file}; unset means pg_dump
# from PATH. On a compose install the client lives in the database container
# and cannot write a host path, so the dump arrives on standard output and
# lands in {file}:
# NARRE_BACKUP_COMMAND=docker compose -f docker-compose.dev.yml exec -T postgres pg_dump --format=custom --no-owner {url}
# Seconds a dump may run before it is killed and the upgrade refused — a
# pg_dump that stalls, or sits at a password prompt, must not block startup
# forever.
# NARRE_BACKUP_TIMEOUT=300

# ---------------------------------------------------------------------------
# Providers — chosen by name, not by a test branch
# ---------------------------------------------------------------------------
# `fake` is the deterministic default: a fresh clone runs with no key. The
# `openai-compatible` entry is one fetch strategy for the chat completions SSE
# shape, which OpenAI, OpenRouter, DeepSeek, Groq and local servers (Ollama,
# llama.cpp, vLLM) all speak — they differ in base URL, model and key, not in
# protocol. A vendor with a different protocol gets its own module next to
# app/kernel/llm/openai_compat.py.
NARRE_LLM_PROVIDER=fake
# NARRE_LLM_PROVIDER=openai-compatible
# NARRE_LLM_BASE_URL=https://api.openai.com/v1
# NARRE_LLM_MODEL=
# NARRE_LLM_API_KEY=            # a server on this machine (localhost, 127.0.0.1,
#                               # host.docker.internal) needs none

# Same shape for embeddings: one fetch strategy for the /embeddings JSON shape.
# The vector column takes whatever width the model answers with — which model a
# user picks is not knowable — and one knowledge base stays with one model: a
# switch is refused with a clear message until the documents are re-uploaded.
NARRE_EMBEDDING_PROVIDER=fake
# NARRE_EMBEDDING_PROVIDER=openai-compatible
# NARRE_EMBEDDING_BASE_URL=https://api.openai.com/v1
# NARRE_EMBEDDING_MODEL=
# NARRE_EMBEDDING_API_KEY=      # same local-host rule as the LLM entry
# NARRE_EMBEDDING_DIMENSIONS=   # optional: ask a truncation-capable vendor
#                               # (OpenAI v3) for fewer than native dimensions

# ---------------------------------------------------------------------------
# E2E stack ports — set these when `just dev` already holds 8000 or 3100.
# ---------------------------------------------------------------------------
# NARRE_E2E_API_PORT=8000
# NARRE_E2E_WEB_PORT=3100
