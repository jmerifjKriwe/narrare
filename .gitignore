# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
dist/
build/
*.egg-info/
.eggs/

# uv
# uv.lock should be committed for reproducible builds

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Golden-Pages Typst probes — per-test scratch docs written inside the
# repo so Typst's --root constraint holds (the package lives in-repo).
# Auto-cleaned by tempfile.TemporaryDirectory; this entry is the
# defence-in-depth against a crash leaving litter behind.
.typst-test-tmp/

# MutMut (mutation testing) — regenerable mutant copies, backups, and sandbox artifacts
mutants*/
.mutmut.pyproject.toml.bak
# Temporary symlinks created by scripts/run_mutmut.py (e.g. narrare_core -> packages/core/narrare_core)
/narrare_core
/narrare

# Type checking
.pyright/
pyrightcache/
.ruff_cache/

# Environment
.env
.env.local
.env.*.local

# Node / Frontend
node_modules/
# Match any .next* variant (covers .next/, .next-stale-vrt/, future experimental dirs).
# next-env.d.ts (no leading dot) is intentionally NOT matched and stays tracked.
packages/web/.next*
packages/web/out/
packages/web/.turbo/
*.tsbuildinfo

# pnpm
packages/web/pnpm-lock.yaml
.pnpm-store/

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store

# Docker
docker-compose.override.yml

# Alembic
apps/api/alembic/versions/*.pyc

# Project data (user projects live outside repo)
data/
.narrare/
*.narrare

# Secrets
*.pem
*.key
*.cert

# Logs
*.log
logs/

# Coverage
.coverage.*

# Coverage reports (root level)
coverage.*.xml

# pytest-cov intermediate files
*,cover

packages/web/skills-lock.json
packages/web/coverage/
packages/web/playwright-report/
packages/web/test-results/

# local stuff
.mcp.json
opencode.json
.tmp/
skills-lock.json
clawpatch-report.md

# Benchmark runner local config — real LLM credentials (template committed:
# benchmark/config.template.yaml; ADR-083 manually-only area)
benchmark/config.local.yaml

# Evidence store (CI artifacts)
.evidence/*.jsonl
test-results/

graphify-out/
