{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "default_agent": "NarrareDevCoordinator",
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "plugin": [
    "./.opencode/plugins/agentmemory-capture.ts"
  ],
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": [
        "/home/kiesow/.local/share/pipx/venvs/code-review-graph/bin/code-review-graph",
        "serve"
      ],
      "timeout": 120000
    },
    "agentmemory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@agentmemory/mcp"
      ],
      "enabled": true,
      "environment": {
        "AGENTMEMORY_URL": "http://localhost:3111"
      }
    }
  },
  "formatter": true,
  "lsp": true
}
