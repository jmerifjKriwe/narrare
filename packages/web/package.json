    "@tanstack/react-query-devtools": "^5.100.14",
    "@tiptap/core": "^3.24.0",
    "@tiptap/extension-character-count": "^3.24.0",
    "@tiptap/extension-drag-handle": "^3.24.0",
    "@tiptap/extension-drag-handle-react": "^3.24.0",
