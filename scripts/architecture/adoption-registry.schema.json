{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "narrare://adoption-registry.schema",
  "title": "Narrare Feature Adoption Registry",
  "description": "Validates adoption-registry.yaml structure per ADR-041 Decision 1.",
  "type": "object",
  "required": ["version", "features"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0.0",
      "description": "Registry schema version — must be 2.0.0."
    },
    "category_defaults": {
      "type": "object",
      "description": "Baseline runtime_requirements per category.",
      "additionalProperties": {
        "$ref": "#/$defs/category_default"
      }
    },
    "features": {
      "type": "object",
      "description": "Feature categories — each key maps to a _bundled/{category}/ directory.",
      "additionalProperties": {
        "$ref": "#/$defs/feature"
      }
    },
    "infrastructure_definitions": {
      "type": "object",
      "description": "Canonical descriptions and evidence criteria for each infrastructure type.",
      "additionalProperties": {
        "$ref": "#/$defs/infra_definition"
      }
    },
    "inline_fallbacks": {
      "type": "array",
      "description": "Registered inline prompts that bypass PromptComposer (ADR-025 Decision 4).",
      "items": {
        "$ref": "#/$defs/inline_fallback"
      }
    },
    "feature_templates": {
      "type": "object",
      "description": "Reference templates for new feature development (ADR-025 Decision 7).",
      "additionalProperties": {
        "$ref": "#/$defs/feature_template"
      }
    }
  },
  "$defs": {
    "runtime_level": {
      "type": "string",
      "enum": ["required", "optional", "none", "not_applicable", "budget_rejected", "provided"],
      "description": "Runtime requirement level for an infrastructure capability."
    },
    "infra_level": {
      "type": "string",
      "enum": ["required", "partial", "optional"],
      "description": "Infrastructure adoption level."
    },
    "context_variable_tier": {
      "type": "string",
      "enum": ["must", "should"],
      "description": "Context variable tier: must (FAIL if missing) or should (WARN if missing)."
    },
    "runtime_requirements": {
      "type": "object",
      "description": "Dict of infrastructure key → requirement level.",
      "additionalProperties": {
        "$ref": "#/$defs/runtime_level"
      }
    },
    "context_variables": {
      "type": "object",
      "description": "Context variable lists by tier. Feature-level requires both must and should.",
      "required": ["must", "should"],
      "properties": {
        "must": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Variables that MUST be present (FAIL if missing)."
        },
        "should": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Variables that SHOULD be present (WARN if missing)."
        }
      },
      "additionalProperties": false
    },
    "context_variables_override": {
      "type": "object",
      "description": "Context variable override — only specifies tiers being overridden.",
      "properties": {
        "must": {
          "type": "array",
          "items": { "type": "string" }
        },
        "should": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "category_default": {
      "type": "object",
      "required": ["runtime_requirements"],
      "additionalProperties": false,
      "properties": {
        "runtime_requirements": {
          "$ref": "#/$defs/runtime_requirements"
        }
      }
    },
    "mode_override": {
      "type": "object",
      "description": "Mode-level overrides for category defaults.",
      "additionalProperties": false,
      "properties": {
        "required_infrastructure": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/infra_level"
          }
        },
        "context_variables": {
          "$ref": "#/$defs/context_variables_override"
        },        "runtime_requirements": {
          "$ref": "#/$defs/runtime_requirements"
        }
      }
    },
    "mode": {
      "type": "object",
      "required": ["requires_runtime_evidence"],
      "additionalProperties": false,
      "properties": {
        "requires_runtime_evidence": {
          "type": "boolean",
          "description": "Whether this mode requires runtime evidence in adoption checks."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the mode."
        },
        "overrides": {
          "$ref": "#/$defs/mode_override",
          "description": "Category-default overrides specific to this mode."
        }
      }
    },
    "feature": {
      "type": "object",
      "required": ["modes", "required_infrastructure", "context_variables"],
      "additionalProperties": false,
      "properties": {
        "modes": {
          "description": "Dict of mode-name → mode config, or empty list for modeless categories.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/mode"
              }
            },
            {
              "type": "array",
              "maxItems": 0,
              "description": "Empty list for modeless categories (e.g. chat)."
            }
          ]
        },
        "required_infrastructure": {
          "type": "object",
          "description": "Infrastructure adoption levels for this feature.",
          "additionalProperties": {
            "$ref": "#/$defs/infra_level"
          }
        },
        "context_variables": {
          "$ref": "#/$defs/context_variables"
        }
      }
    },
    "infra_definition": {
      "type": "object",
      "required": ["description", "evidence"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "inline_fallback": {
      "type": "object",
      "required": ["file", "lines", "variable", "status", "migration_target", "reason"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "lines": { "type": "string" },
        "variable": { "type": "string" },
        "status": { "type": "string" },
        "migration_target": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "feature_template": {
      "type": "object",
      "required": ["extends", "required_files", "must_use", "checklist"],
      "additionalProperties": false,
      "properties": {
        "extends": { "type": "string" },
        "required_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "must_use": {
          "type": "array",
          "items": { "type": "string" }
        },
        "checklist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
