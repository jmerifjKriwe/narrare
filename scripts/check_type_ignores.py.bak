#!/usr/bin/env python3
"""
Type-Ignore Discipline Checker (RULE-23).

Enforces type-ignore suppression discipline across the Narrare codebase:

1. Naked ``# type: ignore`` (without ``[error-code]``) — always an error.
2. Production-code suppressions (``apps/api/narrare/``,
   ``packages/core/narrare_core/``) require a reason comment.
3. Total / production-suppression counts must not exceed the stored baseline.

Exit codes
----------
0 — All checks pass.
1 — Warnings: total suppression count exceeds baseline.
2 — Errors: naked ignores, production total exceeds baseline, or
    uncommented production ignores found.

Usage
-----
::

    # Basic check (uses default baseline)
    python scripts/check_type_ignores.py

    # Custom baseline path
    python scripts/check_type_ignores.py --baseline path/to/baseline.json

    # Update (create / overwrite) the baseline from current state
    python scripts/check_type_ignores.py --update

    # Update to a specific path
    python scripts/check_type_ignores.py --update --baseline path/to/baseline.json

Importable
----------
    >>> from scripts.check_type_ignores import check_type_ignores
    >>> result = check_type_ignores()           # dict with scan + comparison
    >>> result = check_type_ignores("my.json")  # explicit baseline path
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from dataclasses import dataclass, field
from datetime import UTC, datetime
from pathlib import Path
from typing import Any, cast

# ── Project paths ────────────────────────────────────────────────────────────

ROOT = Path(__file__).resolve().parent.parent

PRODUCTION_PREFIXES = (
    str(ROOT / "apps" / "api" / "narrare"),
    str(ROOT / "packages" / "core" / "narrare_core"),
)

SCAN_DIRS = (
    ROOT / "apps",
    ROOT / "packages",
    ROOT / "scripts",
    ROOT / "tests",
)

EXCLUDE_DIRS = frozenset(
    {"__pycache__", ".venv", "_scratch", ".tox", ".mypy_cache", ".pytest_cache"}
)

DEFAULT_BASELINE_PATH = ROOT / "scripts" / "architecture" / "type-ignore-baseline.json"

# If a comment after ``# type: ignore[xxx]`` matches this pattern it counts as
# having a reason.  This covers both explicit "reason:" markers and the most
# common third-party-stub explanations found in the audit.
_REASON_RE = re.compile(
    r"#\s*(?:"
    r"reason\s*:"
    r"|no\s+stubs?\s+for\s+\S+"
    r"|untyped\s+(?:dependency|package|library|third.party)"
    r")",
    re.IGNORECASE,
)

# Regexes for matching type-ignore comments on a single line.
# Both anchored at the comment boundary so we don't match inside strings.
_TYPE_IGNORE_RE = re.compile(r"#\s+type:\s*ignore")
_NAKED_CHECK_RE = re.compile(
    r"#\s+type:\s*ignore"  # the marker itself
    r"(?!\s*\[)"  # not followed by [code]
    r"(?:\s*(?:#|$))",  # only whitespace / EOL / another comment
)
_CODE_EXTRACT_RE = re.compile(r"#\s+type:\s*ignore\s*\[([^\]]+)\]")


# ── Data classes ─────────────────────────────────────────────────────────────


@dataclass
class TypeIgnoreMatch:
    """A single ``# type: ignore`` suppression found in the codebase."""

    file: Path
    line: int
    line_content: str
    code: str = ""  # error code(s) — empty means naked
    is_naked: bool = False  # ``# type: ignore`` without ``[code]``
    has_reason: bool = False  # production only: has a reason comment


@dataclass
class ScanResult:
    """Aggregated results of a full codebase scan."""

    total: int = 0
    production_total: int = 0
    test_total: int = 0
    other_total: int = 0

    naked_ignores: list[TypeIgnoreMatch] = field(default_factory=list[TypeIgnoreMatch])
    uncommented_ignores: list[TypeIgnoreMatch] = field(default_factory=list[TypeIgnoreMatch])

    # file-relative-path → count
    by_file: dict[str, int] = field(default_factory=dict[str, int])
    by_file_production: dict[str, int] = field(default_factory=dict[str, int])
    by_file_test: dict[str, int] = field(default_factory=dict[str, int])

    @property
    def file_count(self) -> int:
        return len(self.by_file)


# ── Baseline helpers ─────────────────────────────────────────────────────────


def load_baseline(path: Path = DEFAULT_BASELINE_PATH) -> dict[str, Any]:
    """Load a JSON baseline, returning an empty dict when absent."""
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        msg = f"Baseline must be a JSON object: {path}"
        raise ValueError(msg)
    return cast("dict[str, Any]", data)


def build_baseline_dict(result: ScanResult) -> dict[str, Any]:
    """Convert a ScanResult into a serializable baseline dict."""
    return {
        "generated_at": datetime.now(UTC).isoformat(),
        "total_count": result.total,
        "production_total": result.production_total,
        "test_total": result.test_total,
        "naked_ignores": len(result.naked_ignores),
        "uncommented_ignores": len(result.uncommented_ignores),
        "files": dict(sorted(result.by_file.items())),
    }


# ── Core check logic ─────────────────────────────────────────────────────────


def _is_production(file: Path) -> bool:
    """True when *file* lives under one of the production directories."""
    s = str(file)
    return any(s.startswith(p) for p in PRODUCTION_PREFIXES)


def _is_test(file: Path) -> bool:
    """True when *file* is part of the ``tests/`` tree."""
    return ROOT / "tests" in file.parents


def _get_category(file: Path) -> str:
    if _is_production(file):
        return "production"
    if _is_test(file):
        return "test"
    return "other"


def _should_skip(file: Path) -> bool:
    """Return True for directories / files that should never be scanned."""
    return any(part in EXCLUDE_DIRS for part in file.parts)


def scan_codebase() -> ScanResult:
    """Walk all Python files under *SCAN_DIRS* and collect type-ignore data."""
    result = ScanResult()

    for scan_root in SCAN_DIRS:
        if not scan_root.exists():
            continue
        for py_file in scan_root.rglob("*.py"):
            if _should_skip(py_file):
                continue

            _scan_single_file(py_file, result)

    # Top offenders — files with the most suppressions
    sorted_files = sorted(result.by_file.items(), key=lambda x: -x[1])
    result.by_file = dict(sorted_files)

    return result


def _scan_single_file(file: Path, result: ScanResult) -> None:
    """Scan one Python file and update *result* in place."""
    try:
        text = file.read_text("utf-8", errors="replace")
    except OSError, UnicodeDecodeError:
        return

    category = _get_category(file)
    file_rel = _relative(file)
    file_count = 0

    for lineno, line in enumerate(text.splitlines(), 1):
        # Does this line contain any type: ignore at all?
        if not _TYPE_IGNORE_RE.search(line):
            continue

        is_naked = bool(_NAKED_CHECK_RE.search(line))
        code = ""
        if not is_naked:
            m = _CODE_EXTRACT_RE.search(line)
            if m:
                code = m.group(1)

        has_reason = bool(_REASON_RE.search(line)) if category == "production" else False

        ti = TypeIgnoreMatch(
            file=file,
            line=lineno,
            line_content=line.strip(),
            code=code,
            is_naked=is_naked,
            has_reason=has_reason,
        )

        file_count += 1
        result.total += 1
        if category == "production":
            result.production_total += 1
        elif category == "test":
            result.test_total += 1
        else:
            result.other_total += 1

        if is_naked:
            result.naked_ignores.append(ti)

        # Uncommented (but scoped!) production ignores
        if category == "production" and not is_naked and not has_reason:
            result.uncommented_ignores.append(ti)

    if file_count:
        result.by_file[file_rel] = file_count
        if category == "production":
            result.by_file_production[file_rel] = file_count
        elif category == "test":
            result.by_file_test[file_rel] = file_count


def _relative(file: Path) -> str:
    """Return a project-root-relative path string."""
    try:
        return str(file.relative_to(ROOT))
    except ValueError:
        return str(file)


# ── Comparison ───────────────────────────────────────────────────────────────


@dataclass
class ComparisonResult:
    """Difference between a fresh scan and the stored baseline."""

    total_delta: int = 0  # current - baseline
    production_delta: int = 0
    naked_count: int = 0
    uncommented_count: int = 0
    new_files: list[str] = field(default_factory=list[str])
    grown_files: list[tuple[str, int, int]] = field(
        default_factory=list[tuple[str, int, int]]
    )  # (file, old, new)


def compare_against_baseline(result: ScanResult, baseline: dict[str, Any]) -> ComparisonResult:
    """Return a *ComparisonResult* between a scan and a baseline dict."""
    cmp = ComparisonResult(
        total_delta=result.total - baseline.get("total_count", 0),
        production_delta=result.production_total - baseline.get("production_total", 0),
        naked_count=len(result.naked_ignores),
        uncommented_count=len(result.uncommented_ignores),
    )

    baseline_files: dict[str, int] = baseline.get("files", {}) or {}

    for file_rel, count in result.by_file.items():
        old = baseline_files.get(file_rel)
        if old is None:
            cmp.new_files.append(file_rel)
        elif count > old:
            cmp.grown_files.append((file_rel, old, count))

    return cmp


# ── Reporting ────────────────────────────────────────────────────────────────


def print_report(result: ScanResult, comparison: ComparisonResult | None) -> None:
    """Print a human-readable report to stdout."""
    # ── Summary line ──
    print(f"\n📊  Type-Ignore Scan — {result.total} total in {result.file_count} files\n")

    cat_parts: list[str] = []
    if result.production_total:
        cat_parts.append(f"{result.production_total} production")
    if result.test_total:
        cat_parts.append(f"{result.test_total} test")
    if result.other_total:
        cat_parts.append(f"{result.other_total} other")
    print(f"    Categories:  {', '.join(cat_parts)}")
    print()

    # ── Naked ignores (top-priority) ──
    if result.naked_ignores:
        print("❌  NAKED IGNORES — # type: ignore without [error-code]\n")
        for ti in result.naked_ignores:
            rel = _relative(ti.file)
            print(f"    {rel}:{ti.line}  {ti.line_content}")
        print()
    else:
        print("✅  No naked # type: ignore found\n")

    # ── Uncommented production ignores ──
    if result.uncommented_ignores:
        count = len(result.uncommented_ignores)
        print(f"⚠️   {count} production suppression(s) without reason comment:\n")
        for ti in result.uncommented_ignores[:20]:  # top 20
            rel = _relative(ti.file)
            print(f"    {rel}:{ti.line}  [{ti.code}]  {ti.line_content}")
        if len(result.uncommented_ignores) > 20:
            print(f"    ... and {len(result.uncommented_ignores) - 20} more")
        print()
    else:
        print("✅  All production suppressions have reason comments\n")

    # ── Top offenders ──
    print("📁  Top 15 files by suppression count:\n")
    sorted_files = sorted(result.by_file.items(), key=lambda x: -x[1])
    for file_rel, count in sorted_files[:15]:
        marker = "  "
        if comparison and comparison.new_files and file_rel in comparison.new_files:
            marker = "🆕"
        elif comparison:
            for gf, old_c, new_c in comparison.grown_files:
                if gf == file_rel:
                    marker = f"↑{new_c - old_c}"
                    break
        print(f"    {marker} {count:4d}  {file_rel}")
    print()

    # ── Comparison against baseline ──
    if comparison is not None:
        print("📈  Baseline comparison:\n")
        print(
            f"    Total:           {result.total:5d}  "
            f"(baseline: {baseline_total(comparison, result)}, "
            f"delta: {comparison.total_delta:+d})"
        )
        print(
            f"    Production:      {result.production_total:5d}  "
            f"(baseline: {baseline_production(comparison, result)}, "
            f"delta: {comparison.production_delta:+d})"
        )
        print(f"    Naked ignores:   {comparison.naked_count:5d}")
        print(f"    Uncommented:     {comparison.uncommented_count:5d}")
        if comparison.new_files:
            print(f"\n    🆕 New files with suppressions:  {len(comparison.new_files)}")
            for f in comparison.new_files[:10]:
                print(f"      + {f}")
            if len(comparison.new_files) > 10:
                print(f"      ... and {len(comparison.new_files) - 10} more")
        if comparison.grown_files:
            print(f"\n    📈 Files with increased count:  {len(comparison.grown_files)}")
            for f, old, new in comparison.grown_files[:10]:
                print(f"      {f}:  {old} → {new}  (+{new - old})")
            if len(comparison.grown_files) > 10:
                print(f"      ... and {len(comparison.grown_files) - 10} more")
        print()


def baseline_total(comparison: ComparisonResult, result: ScanResult) -> int:
    """Derive the baseline total count (current - delta)."""
    return result.total - comparison.total_delta


def baseline_production(comparison: ComparisonResult, result: ScanResult) -> int:
    """Derive the baseline production count."""
    return result.production_total - comparison.production_delta


def build_json_output(result: ScanResult, comparison: ComparisonResult | None) -> dict[str, Any]:
    """Build a machine-readable JSON dict for CI consumption."""
    out: dict[str, Any] = {
        "generated_at": datetime.now(UTC).isoformat(),
        "total_count": result.total,
        "production_total": result.production_total,
        "test_total": result.test_total,
        "other_total": result.other_total,
        "naked_ignores": len(result.naked_ignores),
        "uncommented_ignores": len(result.uncommented_ignores),
        "files": result.by_file,
    }

    if comparison is not None:
        out["baseline"] = {
            "total_delta": comparison.total_delta,
            "production_delta": comparison.production_delta,
            "new_files": comparison.new_files,
            "grown_files": [(f, old, new) for f, old, new in comparison.grown_files],
        }

    return out


# ── Main check function (importable) ─────────────────────────────────────────


def check_type_ignores(baseline_path: str | None = None) -> dict[str, Any]:
    """Run the full type-ignore discipline check and return results.

    Parameters
    ----------
    baseline_path:
        Optional path to a baseline JSON file.  When ``None`` the default
        baseline is used; when the baseline file does not exist the comparison
        is skipped.

    Returns
    -------
    A dictionary with these keys:

    * ``scan`` — :class:`ScanResult` (dataclass, converted to dict)
    * ``comparison`` — :class:`ComparisonResult` or ``None``
    * ``exit_code`` — 0 (pass), 1 (warning), 2 (error)
    * ``json`` — machine-readable JSON dict for CI
    """
    result = scan_codebase()

    baseline: dict[str, Any] = {}
    if baseline_path is not None:
        baseline = load_baseline(Path(baseline_path))
    else:
        baseline = load_baseline(DEFAULT_BASELINE_PATH)

    comparison: ComparisonResult | None = (
        compare_against_baseline(result, baseline) if baseline else None
    )

    # Determine exit code
    exit_code = 0

    # ERROR conditions
    if result.naked_ignores:
        exit_code = 2
    if comparison and comparison.production_delta > 0:
        exit_code = max(exit_code, 2)
    if result.uncommented_ignores:
        exit_code = max(exit_code, 2)

    # WARNING conditions (only if no ERROR already)
    if exit_code == 0 and comparison and comparison.total_delta > 0:
        exit_code = 1

    json_output = build_json_output(result, comparison)

    return {
        "scan": result,
        "comparison": comparison,
        "exit_code": exit_code,
        "json": json_output,
    }


# ── CLI ──────────────────────────────────────────────────────────────────────


def _parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Narrare Type-Ignore Discipline Checker (RULE-23)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Exit codes:\n"
            "  0  All checks pass\n"
            "  1  Warnings (total suppression count exceeds baseline)\n"
            "  2  Errors (naked ignores / production baseline exceeded / "
            "uncommented suppressions)\n\n"
            "Examples:\n"
            "  python scripts/check_type_ignores.py\n"
            "  python scripts/check_type_ignores.py --update\n"
            "  python scripts/check_type_ignores.py --baseline my-baseline.json\n"
        ),
    )
    parser.add_argument(
        "--baseline",
        type=Path,
        default=DEFAULT_BASELINE_PATH,
        help="Path to baseline JSON (default: %(default)s)",
    )
    parser.add_argument(
        "--update",
        action="store_true",
        help="Update (create / overwrite) the baseline file from current scan state",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Print machine-readable JSON to stdout (in addition to human report on stderr)",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = _parse_args(argv)

    # ── Scan ──
    result = scan_codebase()

    # ── Baseline ──
    baseline_path: Path = args.baseline
    if args.update:
        baseline_dict = build_baseline_dict(result)
        baseline_path.parent.mkdir(parents=True, exist_ok=True)
        with baseline_path.open("w", encoding="utf-8") as fh:
            json.dump(baseline_dict, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        print(f"✅  Baseline updated: {baseline_path}  ({result.total} suppressions)")
        return 0

    # ── Compare ──
    baseline_data = load_baseline(baseline_path)
    comparison = compare_against_baseline(result, baseline_data) if baseline_data else None

    # ── Determine exit code ──
    exit_code = 0

    if result.naked_ignores:
        exit_code = 2
    if comparison and comparison.production_delta > 0:
        exit_code = max(exit_code, 2)
    if result.uncommented_ignores:
        exit_code = max(exit_code, 2)

    if exit_code == 0 and comparison and comparison.total_delta > 0:
        exit_code = 1

    # ── Human-readable report ──
    # If --json is set, send the human report to stderr so stdout stays clean
    output_stream = sys.stderr if args.json else sys.stdout
    _orig_stdout = sys.stdout
    sys.stdout = output_stream
    try:
        print_report(result, comparison)

        if exit_code == 0:
            print("✅  RULE-23: All type-ignore discipline checks pass")
        elif exit_code == 1:
            print("⚠️   RULE-23: WARNING — total suppression count exceeds baseline")
        else:
            print("❌  RULE-23: FAILED — type-ignore discipline violations detected")
        print()
    finally:
        sys.stdout = _orig_stdout

    # ── Machine-readable JSON ──
    if args.json:
        json_output = build_json_output(result, comparison)
        json_output["exit_code"] = exit_code
        print(json.dumps(json_output, indent=2, ensure_ascii=False))

    return exit_code


if __name__ == "__main__":
    sys.exit(main())
